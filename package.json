    "content:audit": "node scripts/audit-content.mjs",
    "content:review": "node scripts/review-content.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/newsreader": "^5.2.8",
    "@fontsource/noto-serif": "^5.3.0",
    "@lucide/vue": "^1.59.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "fake-indexeddb": "^6.2.4",
    "sass": "^1.93.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  }
